# ─────────────────────────────────────────────────────────────
# memflow-muse — environment template
# Copy to .env.local and fill in. Never commit real secrets.
# In Lovable, runtime secrets live in the Secrets vault, not here.
# ─────────────────────────────────────────────────────────────

# ── Server-only secrets (process.env.*) ──────────────────────
# mem0 API key — enables real mem0 RAG. Without it the app
# falls back to the in-process mock client.
MEM0_API_KEY=

# Lovable AI Gateway key — auto-provisioned in Lovable Cloud.
# Only needed for self-hosted builds.
LOVABLE_API_KEY=

# ── Public, build-time config (import.meta.env.VITE_*) ───────
# Toggle verbose click-instrumentation logs in the browser.
VITE_DEBUG_CLICKS=false